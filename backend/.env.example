# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Job search (choose one; Adzuna is free & easiest to get approved) ---
# https://developer.adzuna.com/ -> free API_ID + API_KEY
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Alternative: RapidAPI "JSearch" (aggregates LinkedIn/Indeed/Glassdoor listings legally)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# --- AI (matching, resume rewriting, cover letters, assistant) ---
# Free tier, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — override the default model (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-2.5-flash

# --- Gmail OAuth (Google Cloud Console -> OAuth Client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Misc ---
SESSION_SECRET=change_me_to_a_random_string
